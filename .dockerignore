# Node modules - exclude from all workspaces
**/node_modules/
node_modules/
galipette-backend/node_modules/
galipette-portal/node_modules/
galipette-shared-lib/node_modules/

# Build outputs
**/dist/
**/build/
galipette-backend/dist/
galipette-portal/dist/

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (keep sample.env)
**/.env
**/.env.*
!**/.env.example
!**/sample.env

# IDE and editor files
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*~

# OS generated files
**/.DS_Store
**/.DS_Store?
**/._*
**/.Spotlight-V100
**/.Trashes
**/ehthumbs.db
**/Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Docker
**/Dockerfile
**/.dockerignore

# Documentation
README.md
DOCKER_SETUP.md
**/*.md
!galipette-backend/init-db/*.sql

# Test coverage
**/coverage/
**/.nyc_output

# Cache directories
**/.cache
**/.parcel-cache
**/.eslintcache
**/.prettiercache
**/.npm

# Temporary files
**/*.pid
**/*.seed
**/*.pid.lock

# Package manager files (we copy them explicitly)
# Don't exclude package.json and package-lock.json at root level
# !package.json
# !package-lock.json

