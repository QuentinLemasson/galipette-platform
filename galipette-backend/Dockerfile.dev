# Development Dockerfile for Galipette Backend
FROM node:20-alpine

WORKDIR /app

# Install dependencies for native modules, health checks, and database tools
RUN apk add --no-cache python3 make g++ curl postgresql-client

# Copy package files for workspace (better layer caching)
COPY package*.json ./
COPY galipette-backend/package*.json ./galipette-backend/
COPY galipette-shared-lib/package*.json ./galipette-shared-lib/

# Install workspace dependencies
RUN npm ci

# Copy TypeScript configuration (required for path aliases)
COPY tsconfig.base.json ./

# Copy source code
COPY galipette-backend ./galipette-backend
COPY galipette-shared-lib ./galipette-shared-lib

# Make startup script executable
RUN chmod +x galipette-backend/scripts/start-dev.sh

# Expose backend port
EXPOSE 3000

# Start development server with Prisma generation at runtime
CMD ["sh", "galipette-backend/scripts/start-dev.sh"]
