# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# For Docker development environment:
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/galipette_db?schema=public"
# For local development (when running backend outside Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/galipette_db?schema=public"

# Security
# JWT_SECRET="your-secret-key-here"
# JWT_EXPIRES_IN="24h"

# Logging
LOG_LEVEL="info" # debug, info, warn, error