# Development Dockerfile for Galipette Portal
# Using Debian for better LightningCSS binary compatibility
FROM node:20-slim

WORKDIR /app

# Install build dependencies for native modules (lightningcss, etc.)
# Using apt-get for Debian instead of apk for Alpine
RUN apt-get update && apt-get install -y \
    curl \
    python3 \
    make \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy package files for workspace
COPY package*.json ./
COPY galipette-portal/package*.json ./galipette-portal/
COPY galipette-shared-lib/package*.json ./galipette-shared-lib/

# Install workspace dependencies
RUN npm ci

# Copy TypeScript configuration (required for path aliases)
COPY tsconfig.base.json ./

# Copy source code
COPY galipette-portal ./galipette-portal
COPY galipette-shared-lib ./galipette-shared-lib

# Make startup script executable
RUN chmod +x galipette-portal/scripts/start-dev.sh

# Expose Vite dev server port
EXPOSE 5173

# Start development server with native module rebuild at runtime
CMD ["sh", "galipette-portal/scripts/start-dev.sh"]
