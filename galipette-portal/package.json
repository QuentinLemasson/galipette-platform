{
  "name": "galipette-portal",
  "version": "0.0.1",
  "displayName": "Galipette Portal",
  "description": "A global application for the Galipette Cendree TTRPG platform",
  "author": {
    "name": "Quentin Lemasson",
    "email": "q.v.lemasson@gmail.com"
  },
  "contributors": [
    {
      "name": "Quentin Lemasson",
      "email": "q.v.lemasson@gmail.com"
    }
  ],
  "homepage": "/tbd",
  "bugs": "/tbd",
  "repository": {
    "type": "git",
    "url": "/tbd"
  },
  "keywords": [
    "galipette",
    "cendree",
    "ttrpg",
    "portal"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit",
    "podman:build": "podman build -t galipette-portal .",
    "podman:run": "podman run --name galipette-portal -p 3000:80 galipette-portal",
    "podman:dev": "powershell -ExecutionPolicy Bypass -File dev.ps1",
    "podman:compose": "podman-compose up --build"
  },
  "dependencies": {
    "@galipette/shared": "file:../galipette-shared-lib",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@reduxjs/toolkit": "^2.9.0",
    "@tailwindcss/vite": "^4.1.14",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.64.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "msw": "^2.11.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "shadcn": "^3.4.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
